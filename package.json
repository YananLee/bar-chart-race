{
  "name": "livelychart-bar-race",
  "version": "1.0.0",
  "description": "Open-source bar chart race for the web. 动态条形图 / Bar Chart Race JS library.",
  "keywords": [
    "bar chart race",
    "bar-chart-race",
    "animated bar chart",
    "ranking chart",
    "data visualization",
    "javascript",
    "csv",
    "dynamic chart",
    "动态条形图",
    "条形竞赛",
    "动态排名"
  ],
  "homepage": "https://livelychart.com",
  "bugs": {
    "url": "https://github.com/YananLee/bar-chart-race/issues"
  },
  "license": "MIT",
  "author": "LivelyChart",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YananLee/bar-chart-race.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup && cp dist/index.global.js docs/bar-chart-race.global.js"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  }
}
